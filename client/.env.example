# PI App Client — Environment Variables
# Copy this file to .env.local and fill in the values.
# Next.js exposes only NEXT_PUBLIC_* vars to the browser.

# Base URL of the pi-api Catalyst Function.
# In dev (catalyst serve): typically http://localhost:3000 or the function URL shown by catalyst serve.
# In production: the Catalyst Function URL from your project console.
NEXT_PUBLIC_PI_API_URL=http://localhost:9000

# Catalyst Auth base URL for login/logout redirects.
# Format: https://<your-project-id>.catalystappsail.com/__catalyst/auth/login
# Find this in: Catalyst Console → Authentication → Login URL
NEXT_PUBLIC_CATALYST_AUTH_BASE=https://your-project-id.catalystappsail.com/__catalyst/auth/login
