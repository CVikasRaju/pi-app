# PI App Function — Environment Variables
# Copy this file to .env and fill in the values before running catalyst serve.
# Never commit .env to version control.

# Your Catalyst project ID (from catalyst.json or Catalyst Console)
CATALYST_PROJECT_ID=

# Catalyst Auth client ID for server-side SDK initialization
CATALYST_CLIENT_ID=

# AuditLog table numeric ID (from Catalyst Console → Data Store → AuditLog → Table ID)
# Only needed if you reference it by ID; the SDK also accepts the table name string.
AUDIT_LOG_TABLE_ID=

# Set to 'true' in test environments to make audit log write failures throw (vs. console.error)
AUDIT_STRICT_MODE=false

# Allowed CORS origin for the Next.js client (e.g. http://localhost:3000 in dev)
CLIENT_ORIGIN=http://localhost:3000
