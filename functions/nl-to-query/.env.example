# nl-to-query — Environment Variables
# Copy to .env and fill in values before running catalyst serve

# Your Catalyst project ID (from catalyst.json or Catalyst Console)
CATALYST_PROJECT_ID=your-project-id

# QuickML LLM Serving model ID (from Catalyst Console → QuickML → LLM Serving)
# If not set, falls back to regex intent parsing + template answer composition.
QUICKML_MODEL_ID=

# Service token for QuickML REST API calls (from Catalyst Console → App → Service Token)
CATALYST_SERVICE_TOKEN=

# Internal secret — must match INTERNAL_NL_SECRET in chat-router .env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_NL_SECRET=change-me-nl-secret
