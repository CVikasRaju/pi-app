# Audit Logger Function — Environment Variables
# Copy this file to .env and fill in the values before running catalyst serve.
# Never commit .env to version control.

# Shared secret for internal function-to-function auth.
# Set the same value in any Function that calls this service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AUDIT_SECRET=

# Set to 'true' to enable verbose request logging
DEBUG=false
