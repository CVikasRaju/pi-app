# chat-router — Environment Variables
# Copy to .env and fill in values before running catalyst serve

CATALYST_PROJECT_ID=your-project-id

# Origin for CORS (your Catalyst Slate URL or localhost)
CLIENT_ORIGIN=http://localhost:3000

# Internal Function URLs (from catalyst serve output or Catalyst Console → Functions)
NL_TO_QUERY_URL=http://localhost:9001
RESPONSE_COMPOSER_URL=http://localhost:9002
PDF_EXPORT_URL=http://localhost:9003
AUDIT_LOGGER_URL=http://localhost:9005

# Internal secrets — must match the corresponding function .env files
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_NL_SECRET=change-me-nl-secret
INTERNAL_COMPOSER_SECRET=change-me-composer-secret
INTERNAL_PDF_SECRET=change-me-pdf-secret
INTERNAL_AUDIT_SECRET=change-me-audit-secret
